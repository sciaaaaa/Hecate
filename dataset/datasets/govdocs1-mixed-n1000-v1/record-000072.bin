<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd"><html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><meta name="robots" content="INDEX,NOFOLLOW,NOARCHIVE"><link rel="schema.DC" href="http://purl.org/DC/elements/1.0/"><meta name="citation_journal_title" content="Molecular Biology of the Cell"><meta name="citation_title" content="QKI Binds MAP1B mRNA and Enhances MAP1B Expression during Oligodendrocyte Development"><meta name="citation_authors" content="Lixia Zhao, Li Ku, Yuntao Chen, Mingjing Xia, Patrizia LoPresti, and  Yue Feng"><meta name="citation_date" content="2006 October"><meta name="citation_issue" content="10"><meta name="citation_volume" content="17"><meta name="citation_firstpage" content="4179"><meta name="citation_doi" content="10.1091/mbc.E06-04-0355"><meta name="citation_pdf_url" content="http://www.pubmedcentral.nih.gov/picrender.fcgi?artid=1635361&amp;blobtype=pdf"><meta name="citation_abstract_html_url" content="http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=1635361&amp;rendertype=abstract"><meta name="citation_fulltext_html_url" content="http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=1635361"><meta name="citation_pmid" content="16855020"><meta name="DC.Title" content="QKI Binds MAP1B mRNA and Enhances MAP1B Expression during Oligodendrocyte Development"><meta name="DC.Type" content="Text"><meta name="DC.Publisher" content="American Society for Cell Biology"><meta name="DC.Contributor" content="Lixia Zhao"><meta name="DC.Contributor" content="Li Ku"><meta name="DC.Contributor" content="Yuntao Chen"><meta name="DC.Contributor" content="Mingjing Xia"><meta name="DC.Contributor" content="Patrizia LoPresti"><meta name="DC.Contributor" content="Yue Feng"><meta name="DC.Date" content="2006 October"><meta name="DC.Identifier" content="10.1091/mbc.E06-04-0355"><meta name="DC.Language" content="en"><link rel="stylesheet" href="corehtml/pmc/css/pmcstatic.css" type="text/css"><link rel="stylesheet" href="corehtml/pmc/css/pmcbase1.css" type="text/css"><link rel="stylesheet" href="corehtml/pmc/css/pmcbars-green.css" type="text/css"><link rel="stylesheet" href="corehtml/pmc/css/pmcbody3.css" type="text/css"><link rel="stylesheet" href="corehtml/pmc/css/pmcrefs1.css" type="text/css"><script type="text/javascript" src="corehtml/pmc/js/common.js"></script><script type="text/javascript">window.name="mainwindow";</script><link href="http://www.ncbi.nlm.nih.gov/corehtml/jsutils/css/tileshop_pmc.1/tileshop_pmc.1.css" type="text/css" rel="stylesheet"><script type="text/javascript" src="http://www.ncbi.nlm.nih.gov/corehtml/jsutils/utils.1.js"></script><script>utils.jsLoader.sBase = "http://www.ncbi.nlm.nih.gov/corehtml/jsutils/";</script><script type="text/javascript" src="http://www.ncbi.nlm.nih.gov/corehtml/jsutils/tileshop_pmc.1/tileshop_pmc.1.js"></script><script type="text/javascript" src="http://www.ncbi.nlm.nih.gov/corecgi/tileshop/tileshop_data_db.1.js"></script><title>QKI Binds MAP1B mRNA and Enhances MAP1B Expression during Oligodendrocyte Development</title></head><body class="pmc-body"><a id="top" name="top"></a><table cellpadding="0" cellspacing="0" width="100%" border="0"><tr valign="top"><td colspan="3"><table border="0" cellspacing="0" cellpadding="0" style="border-collapse: collapse;"><tr><td width="145" valign="top"><img src="corehtml/pmc/pmcgifs/pmc3_logo_v5.gif" border="0" usemap="#pmclogo" alt="pmc logo image"><map name="pmclogo"><area shape="rect" alt="Journal List" coords="65,52,137,67" href="fprender.fcgi"><area shape="rect" alt="Search" coords="7,52,52,67" href="redirect3.cgi?&amp;&amp;auth=0LqzIHUrJP_qQorv9YqXZgk1lGIvaTTYkpoVY6Azq&amp;reftype=other&amp;artid=1635361&amp;article-id=1635361&amp;iid=136628&amp;issue-id=136628&amp;jid=1&amp;journal-id=1&amp;FROM=Article%7CLogo&amp;TO=Entrez%7CSearch%7CAll%20PMC&amp;rendering-type=normal&amp;&amp;http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?db=pmc"><area shape="rect" alt="pmc logo image" coords="0,0,145,75" href="./"></map></td><td height="75" valign="top" style="padding-left: 4px;"><div><img align="top" border="0" src="corehtml/pmc/pmcgifs/mbclogo3.gif" alt="Logo of mbc" usemap="#logo-imagemap"><map id="logo-imagemap" name="logo-imagemap"><area alt="Journal URL: redirect3.cgi?&amp;&amp;auth=0-9AkBSsJut599-hCKP8_jOW2QjSnsZFknUgiZ5ON&amp;reftype=publisher&amp;artid=1635361&amp;article-id=1635361&amp;iid=136628&amp;issue-id=136628&amp;jid=1&amp;journal-id=1&amp;FROM=Article|Banner&amp;TO=Publisher|Other|N%2FA&amp;rendering-type=normal&amp;&amp;http://www.molbiolcell.org" shape="rect" coords="0,0,500,100" href="redirect3.cgi?&amp;&amp;auth=0h1NjLScf67MJ7wPyzNM_sQRhjT2VjwbD7nQFjk1y&amp;reftype=publisher&amp;artid=1635361&amp;article-id=1635361&amp;iid=136628&amp;issue-id=136628&amp;jid=1&amp;journal-id=1&amp;FROM=Article%7CBanner&amp;TO=Publisher%7COther%7CN%2FA&amp;rendering-type=normal&amp;&amp;http://www.molbiolcell.org" onclick="focuswin('pmc_ext')" target="pmc_ext"></map></div></td></tr></table></td></tr></table><table cellpadding="0" cellspacing="3" width="100%" border="0"><tr><td></td><td colspan="2"><div class="navlink-box navlink-box-green"><a href="fprender.fcgi" class="navlink">Journal List</a><span> &gt; </span><a class="navlink" href="tocrender.fcgi?journal=1&amp;action=archive">Mol Biol Cell</a><span> &gt; </span><a class="navlink" href="tocrender.fcgi?iid=136628">v.17(10); Oct 2006</a></div></td></tr><tr><td width="145" valign="top" class="sidebar-cell"><div class="sidebar-article-navigation-box"><div class="sidefm-pmclink-item"><a href="articlerender.fcgi?artid=1635361&amp;rendertype=abstract" class="sidefm-pmclink">Abstract</a></div><div class="sidefm-pmccurrent-item"><a class="sidefm-pmclink" href="javascript:return(false);"><span class="sidebar-menu-square-image-holder"><img border="0" src="corehtml/pmc/pmcgifs/square.gif" alt="&gt;"></span>Full Text</a></div><div class="sidefm-pmclink-item"><a href="picrender.fcgi?artid=1635361&amp;blobtype=pdf" class="sidefm-pmclink">PDF (935K)</a></div><div class="sidefm-pmclink-item"><a href="tocrender.fcgi?iid=136628" class="sidefm-pmclink">Contents</a></div><div class="sidefm-pmclink-item"><a href="tocrender.fcgi?journal=1&amp;action=archive" class="sidefm-pmclink">Archive</a></div></div><div class="sidebar-pubmed-box"><div class="sidebar-pubmed-links-to-box"><form name="pubmedLinks" onsubmit="return pubMedDbLinkSubmit(this)"><div class="sidefm-pmsubhead"><label for="pubmedOption">Related material:</label></div><select name="pubmedOption" id="pubmedOption" class="sidefm-pmart" onchange="return pubMedDbLinkSubmit(this)"><option value="redirect3.cgi?&amp;&amp;auth=0FYyH2BfJc_iyjXJZ08Ex3MFav55stTtPurEyEkJW&amp;reftype=abs&amp;refto=entrez&amp;reffrom=sidebar&amp;artid=1635361&amp;article-id=1635361&amp;iid=136628&amp;issue-id=136628&amp;jid=1&amp;journal-id=1&amp;FROM=Article|Navigation&amp;TO=Entrez|PubMed|Record&amp;rendering-type=normal&amp;&amp;http://www.ncbi.nlm.nih.gov/pubmed/16855020">PubMed record</option><option selected value="redirect3.cgi?&amp;&amp;auth=0VsRPF-Ta-q1fuJfQIVEjyfmmx5x_BYQee0XroAG4&amp;reftype=relart&amp;refto=entrez&amp;reffrom=sidebar&amp;artid=1635361&amp;article-id=1635361&amp;iid=136628&amp;issue-id=136628&amp;jid=1&amp;journal-id=1&amp;FROM=Article|Navigation&amp;TO=Entrez|PubMed|Related%20Records&amp;rendering-type=normal&amp;&amp;http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?db=PubMed&amp;cmd=Link&amp;dbFrom=PubMed&amp;from_uid=16855020">PubMed related arts</option><option value="redirect3.cgi?&amp;&amp;auth=04GCvI-oEvhHGPnDsVKom1AgpSw3dYK6u52m0XkVR&amp;reftype=linkout&amp;refto=entrez&amp;reffrom=sidebar&amp;artid=1635361&amp;article-id=1635361&amp;iid=136628&amp;issue-id=136628&amp;jid=1&amp;journal-id=1&amp;FROM=Article|Navigation&amp;TO=Entrez|PubMed|Linkout&amp;rendering-type=normal&amp;&amp;http://www.ncbi.nlm.nih.gov/sites/entrez?Db=pubmed&amp;Cmd=ShowLinkOut&amp;TermToSearch=16855020">Pub