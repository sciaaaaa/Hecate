<html>
<head>
<title>Pipeline Integrity Management Mapping Application</title>
<script language="javascript">
function checkEnter(event){
	var code = 0; 
	code = event.keyCode;
	if (code==13)
		validate();
}

function validate(){
	if (document.newchoice.accept.checked){
		var username = document.newchoice.username.value;
		var password = document.newchoice.password.value;
		if(username=="" || password=="") {
			alert("Please make sure that you have entered both username and password.");
		} else {
//			document.newchoice.action = "newlogin.asp";
			document.newchoice.submit();
		}
	}else{
		alert("Please make sure that you have accepted the policy.");
	}
}
</script>
    <link type="text/css" rel="stylesheet" href="../npms.css" />
    <script type="text/javascript" src="../npms.js"></script>
