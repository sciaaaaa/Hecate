<html>
<head>
                                                           
  <meta http-equiv="Content-Type" content="text/html;CHARSET=iso-8859-1">
                                                           
  <meta name="description" content="Tools for comparative genomics">
                                                           
  <meta name="keywords"
 content="genome, genome browser, VISTA, GenomeVISTA, LBNL, bioinformatics, whole-genome alignment, comparative genomics">
  <title>VISTA Genome Browser</title>
                                                                        
<script language="JavaScript">
var oldNetscape = document.layers;
var BAD_VALUE=-9999;
var java_disabled="/notenabled.html";
function formLoad()
{
	var form = document.inForm;
        var released = form.released;
	var family = released.options[released.selectedIndex].value;
//        var genomeIndex = form.genomes.selectedIndex;
//	  var family = form.genomes.options[genomeIndex].value;
        var positionText = form.position.value;
        if(!positionText)form.position.value = genomes[family].default_pos;   
}
function changeGenome(index) {
	var form = document.inForm;
	if( form.genomes.selectedIndex != index )
	    form.genomes.selectedIndex = index;
	form.position.value=genomes[index].default_pos;
	form.target="_self";
	form.bg.value=genomes[index].family;
        var purl =parent.location.protocol+"//"+parent.location.hostname+parent.location.pathname;
	var selector="vista";
	if(form.selector[1].checked)selector="ucsc";
	window.open(purl+"?bg="+genomes[index].family+"&selector="+selector,"_top");
}

function changeFamily(family) {
        var form = document.inForm;
	form.bg.value=family;
	var purl =parent.location.protocol+"//"+parent.location.hostname+parent.location.pathname;
	var selector="vista";
	if(form.selector[1].checked)selector="ucsc";
	window.open(purl+"?bg="+family+"&selector="+selector,"_top");	
}

function changePosition() {
    var form = document.inForm;
    var genomesList = form.genomes;
    var index = genomesList.selectedIndex;
    var family = genomesList.options[index].value;
    genomes[family].default_pos=form.position.value;
    return true;
}
function checkForm() {

    var form = document.inForm;
    var genomesList = form.genomes;
    if(genomesList.options[genomesList.selectedIndex].value==BAD_VALUE) {
	alert("Please choose base genome from the list");
	genomesList.focus();
	return false;
    }	
    var position_chars = form.position.value.split('');
    var position_string = "";
    for(i=0;i<position_chars.length;i++){
       if(position_chars[i] != '"')position_string+=position_chars[i];
    }
    form.position.value = position_string;
    if(form.position.value=="") {
	alert("Please enter the position in the field!");
	form.position.focus();
	return false;
    }
    if(form.position.value.length < 2) {
	alert("Please enter at least two characters the field");
	form.position.focus();
	return false;
    }
    var released = form.released;
    var family = released.options[released.selectedIndex].value;
    var info = genomes[family];
//    alert( family + " Run "+ info.run + " " + info.tbl_name);
//    return false;
     form.bg.value=info.family; 
     form.run.value=info.run; 
     form.ref.value=info.tbl_name;
     if((form.bg.value == 'rice')||
	(form.bg.value == 'ara')||
	(form.bg.value == 'osa1')
       ){
         form.selector[0].checked=true;
	 form.selector[1].checked=false;
       }
     var maxWidth = screen.availWidth;
     var maxHeight = screen.availHeight;
     form.availwidth.value = maxWidth;
     form.availheight.value= maxHeight;
     if(!maxWidth)maxWidth=800;
     if(!maxHeight)maxHeight=700;
     maxHeight=Math.min(maxHeight,700);
     maxWidth =Math.min(maxWidth,1200);
     form.clientwidth.value = maxWidth;
     form.clientheight.value = maxHeight;
     var targ = "_self";
	if(form.selector[0].checked){
	  if(!navigator.javaEnabled()){
             form.hasjava.value = "disabled";
	  }
	  form.browser.value = 'vista';
          form.scrollbar.value = '0';
	  //form.run.value = '';
          targ="VGB"+Math.round(1000000*Math.random());
	  window.open("about:blank", targ, "fullscreen=no,toolbar=no,status=no,menubar=no,scrollbars=no,resizable=yes,directories=no,location=no,height="+maxHeight+",width="+maxWidth+",top=0,left=0");
	}
	if(form.selector[1].checked){
	  form.browser.value = 'UCSC';
          targ="UCSC"+Math.round(1000000*Math.random());
	  window.open("about:blank", targ);
	}
     form.target=targ;
     return true;
}
function initForm(){
   if(document.layers)document.layers["lwarn"].visibility="hide";
   else if(document.all)document.all["warn"].style.display= "none";
   else document.getElementById("warn").style.display= "none";
   formLoad();
}
</script> 

</head>
