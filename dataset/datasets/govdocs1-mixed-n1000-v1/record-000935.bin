<script language="javascript" type="text/javascript">
    
    //shows the topics on rollover
    function showTopics(lnk)
    {
        var link = $get('ctl00_ucNavigation_lnkTopics');
        
        if (!link)
            link = $get('ctl00_ucNavigation_lnkTopicsPath')
        
        changeImageSrcOver(link);
        
        //don't show the dropdown-menu if the user is in the topics-tab:
        var images = lnk.getElementsByTagName('img');   
        if (images.length > 0)
        {
            var image = images[0];            
            if (image.src.indexOf('hover') != -1 || image.src.indexOf('off') != -1)
            {
                $get('topics').style.visibility = 'visible';
                var bounds = Sys.UI.DomElement.getBounds(lnk);
                $get('topics').style.top = bounds.y + bounds.height - 15 + 'px';
                $get('topics').style.left = bounds.x + 'px';   
            }
        }
    }
    
    function hideTopics(lnk)
    {
        var link = $get('ctl00_ucNavigation_lnkTopics');
        
        if (!link)
            link = $get('ctl00_ucNavigation_lnkTopicsPath')
        
        changeImageSrcOut(link);
        $get('topics').style.visibility = 'hidden';
    }
    
    
    // handles preloading and rollover swapping for navigation images
    function changeImageSrcOver(lnk)
    {
        //set on-state for hyperlink image
        var images = lnk.getElementsByTagName('img');
        if (images.length > 0)
        {
            var image = images[0];
            image.src = image.src.replace('off', 'hover');
        }
    }
    
    function changeImageSrcOut(lnk)
    {
        var originalString = 'http://www.nrchmi.samhsa.gov:80/resource/view.aspx?id=26298&aspxautodetectcookiesupport=1';
        
        //set off-state for hyperlink image if not currently selected
        if (originalString.indexOf(lnk.href) == -1)
        {
            var images = lnk.getElementsByTagName('img');
            
            if (images.length > 0)
            {
                var image = images[0];            
                image.src = image.src.replace('hover', 'off');
            }
        }
    }
    
    function changeImageSrcOn()
    {
        //now, check for on-state of images
        var links = document.getElementsByTagName('a');
        var originalString = 'http://www.nrchmi.samhsa.gov/resource/view.aspx?id=26298&aspxautodetectcookiesupport=1';
        var channelId = '26298';
        originalString = originalString.toLowerCase();
        
        //super-channel?
        if (originalString.indexOf('super') == -1)
        {
            //exclude channels in top-navigation
            if (channelId != '1' && channelId != '16' && channelId != '17' && channelId != '18' && channelId != '26' && channelId != '100' && channelId != '102')
                channelId = "";
                
            originalString = originalString.substring(0, originalString.lastIndexOf('/'));
                   
            for (var i = 0; i < links.length; i++)
            {
                //set on state
                if (    (originalString == links[i].href.substring(0, links[i].href.lastIndexOf('/')).toLowerCase() &&  originalString.indexOf("channel") == -1 && channelId == links[i].href.substring(links[i].href.lastIndexOf("id=") + 3)) || 
                        (originalString == links[i].href.substring(0, links[i].href.lastIndexOf('/')).toLowerCase() && (channelId == links[i].href.substring(links[i].href.lastIndexOf("id=") + 3) || 
                        (channelId == "" && links[i].href.lastIndexOf("id=")== -1     ))      ))
                {
                    //set on-state for hyperlink image
                    var images = links[i].getElementsByTagName('img');
                    
                    if (images.length > 0)
                    {
                        var image = images[0];
                        image.src = image.src.replace('off', 'on');
                        image.src = image.src.replace('hover', 'on');
                    }
                }
            }
        }
        else
        {
            for (var i = 0; i < links.length; i++)
            {
                if (originalString == links[i].href.toLowerCase() || (originalString.indexOf("about") != -1 && links[i].href.toLowerCase().indexOf("about") != -1))
                {
                    //set on-state for hyperlink image
                    var images = links[i].getElementsByTagName('img');
                    
                    if (images.length > 0)
                    {
                        var image = images[0];
                        image.src = image.src.replace('off', 'on');
                        image.src = image.src.replace('hover', 'on');
                    }
                }
            }
        }
    }
    
    //originalString.indexOf(links[i].href.substring(links[i].href.lastIndexOf('/'), links[i].href.length).toLowerCase()) != -1
    changeImageSrcOn();
</script>


        </div>
        
