        <script>function AddConfirmExternalLinks(){urls = new Array('samhsa','gotomeeting','openads','adobe','211','hud');for (var i = 0; i < document.links.length; ++i){ if (document.links[i].href.indexOf('pathprogram') != -1){document.links[i].target = '_self';document.links[i].href = "javascript:$find('mpePath').show();";}else if (document.links[i].href.substring(0, 10) != location.href.substring(0,10) && document.links[i].href.indexOf('DoPostBack') == -1 && document.links[i].href.indexOf('doPostBack') == -1 && document.links[i].href.indexOf('mailto:') == -1 && document.links[i].href.indexOf('startSpell') == -1 && document.links[i].href.indexOf('javascript') == -1){ var addLink = true; for (var j = 0; j < urls.length; ++j){if (document.links[i].href.indexOf(urls[j]) != -1){addLink = false;}}if (addLink == true){document.links[i].target = '_new';document.links[i].name = document.links[i].href;document.links[i].href = '../DisclaimerPopup.aspx?Url=' + document.links[i].href;}}}}AddConfirmExternalLinks();</script>
