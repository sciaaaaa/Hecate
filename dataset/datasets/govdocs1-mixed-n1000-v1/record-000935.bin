<script>
    
    //little function to cause postback when ok button in modalpopup is clicked
    function clickOKAfterValidate(sender, e) 
    { 
        validator1 = $get('ctl00_MainContent_ResourceView1_revEmail');
        validator2 = $get('ctl00_MainContent_ResourceView1_reqEmail');
        
        if ($get('ctl00_MainContent_ResourceView1_txtTo').value.length > 0)
            validator2.isvalid = true;
        else
            validator2.isvalid = false;
        
        //disable send-button
        if(validator1.isvalid && validator2.isvalid)
        {
            $get('ctl00_MainContent_ResourceView1_btnEmailOk').disabled = false;
            __doPostBack(sender,e); 
        }
        else
        {
            $get('ctl00_MainContent_ResourceView1_btnEmailOk').disabled = true;
        } 

    }
    
    function validateTo()
    {
        validator1 = $get('ctl00_MainContent_ResourceView1_revEmail');
        validator2 = $get('ctl00_MainContent_ResourceView1_reqEmail');
        
        if ($get('ctl00_MainContent_ResourceView1_txtTo').value.length > 0)
            validator2.isvalid = true;
        else
            validator2.isvalid = false;
        
        //disable send-button
        if(validator1.isvalid && validator2.isvalid)
        {
            $get('ctl00_MainContent_ResourceView1_btnEmailOk').disabled = false;
        }
        else
        {
            $get('ctl00_MainContent_ResourceView1_btnEmailOk').disabled = true;
        } 
    }
    
</script>

