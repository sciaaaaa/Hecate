                <div align="center"><img src="graphics/loc.gif" width="312" height="79" alt="[graphic] Property Title" title="[graphic]"Property></div>
              </td>
              <td><a href="nat.htm" onMouseOut="MM_swapImgRestore()" onMouseOver="MM_swapImage('Image99','','graphics/boatnextsite.gif',1)"><img name="Image99" border="0" src="graphics/boatnextsite-start.gif" width="100" height="49" alt="[graphic] Proceed to Next Site" title="[graphic] Proceed to Next Site"></a> 
