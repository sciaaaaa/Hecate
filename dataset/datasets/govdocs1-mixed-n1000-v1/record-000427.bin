        <div align="center"> <!-- #BeginEditable "title%20prev%20next%20buttons" --> 
          <table width="536" border="0" background="graphics/parchmentpiece-lightest.jpg">
            <tr> 
              <td><a href="two.htm" onMouseOut="MM_swapImgRestore()" onMouseOver="MM_swapImage('Image95','','graphics/hikers-return.gif',1)"><img name="Image95" border="0" src="graphics/hikers-return-start.gif" width="116" height="48" alt="[graphic] Return to Previous Site" title="[graphic] Return to Previous Site"></a></td>
