<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd"><html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><meta name="robots" content="INDEX,NOFOLLOW,NOARCHIVE"><link rel="schema.DC" href="http://purl.org/DC/elements/1.0/"><meta name="citation_journal_title" content="Proceedings of the National Academy of Sciences of the United States of America"><meta name="citation_title" content="From the Cover: Thousand-year-long Chinese time series reveals climatic forcing of decadal locust dynamics"><meta name="citation_authors" content="Leif Christian Stige, Kung-Sik Chan, Zhibin Zhang, David Frank, and  Nils C. Stenseth"><meta name="citation_date" content="2007 October 9"><meta name="citation_issue" content="41"><meta name="citation_volume" content="104"><meta name="citation_firstpage" content="16188"><meta name="citation_doi" content="10.1073/pnas.0706813104"><meta name="citation_pdf_url" content="http://www.pubmedcentral.nih.gov/picrender.fcgi?artid=2042183&amp;blobtype=pdf"><meta name="citation_abstract_html_url" content="http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=2042183&amp;rendertype=abstract"><meta name="citation_fulltext_html_url" content="http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=2042183"><meta name="citation_pmid" content="17878300"><meta name="DC.Title" content="From the Cover: Thousand-year-long Chinese time series reveals climatic forcing of decadal locust dynamics"><meta name="DC.Type" content="Text"><meta name="DC.Publisher" content="National Academy of Sciences"><meta name="DC.Contributor" content="Leif Christian Stige"><meta name="DC.Contributor" content="Kung-Sik Chan"><meta name="DC.Contributor" content="Zhibin Zhang"><meta name="DC.Contributor" content="David Frank"><meta name="DC.Contributor" content="Nils C. Stenseth"><meta name="DC.Date" content="2007 October 9"><meta name="DC.Identifier" content="10.1073/pnas.0706813104"><meta name="DC.Language" content="en"><link rel="stylesheet" href="corehtml/pmc/css/pmcstatic.css" type="text/css"><link rel="stylesheet" href="corehtml/pmc/css/pmcbase1.css" type="text/css"><link rel="stylesheet" href="corehtml/pmc/css/pmcbars-navy.css" type="text/css"><link rel="stylesheet" href="corehtml/pmc/css/pmcbody2.css" type="text/css"><link rel="stylesheet" href="corehtml/pmc/css/pmcrefs2.css" type="text/css"><script type="text/javascript" src="corehtml/pmc/js/common.js"></script><script type="text/javascript">window.name="mainwindow";</script><link href="http://www.ncbi.nlm.nih.gov/corehtml/jsutils/css/tileshop_pmc.1/tileshop_pmc.1.css" type="text/css" rel="stylesheet"><script type="text/javascript" src="http://www.ncbi.nlm.nih.gov/corehtml/jsutils/utils.1.js"></script><script>utils.jsLoader.sBase = "http://www.ncbi.nlm.nih.gov/corehtml/jsutils/";</script><script type="text/javascript" src="http://www.ncbi.nlm.nih.gov/corehtml/jsutils/tileshop_pmc.1/tileshop_pmc.1.js"></script><script type="text/javascript" src="http://www.ncbi.nlm.nih.gov/corecgi/tileshop/tileshop_data_db.1.js"></script><title>From the Cover: Thousand-year-long Chinese time series reveals climatic forcing of decadal locust dynamics</title></head><body class="pmc-body"><a id="top" name="top"></a><table cellpadding="0" cellspacing="0" width="100%" border="0"><tr valign="top"><td colspan="3"><table border="0" cellspacing="0" cellpadding="0" style="border-collapse: collapse;"><tr><td width="145" valign="top"><img src="corehtml/pmc/pmcgifs/pmc3_logo_v5.gif" border="0" usemap="#pmclogo" alt="pmc logo image"><map name="pmclogo"><area shape="rect" alt="Journal List" coords="65,52,137,67" href="fprender.fcgi"><area shape="rect" alt="Search" coords="7,52,52,67" href="redirect3.cgi?&amp;&amp;auth=0j3tR0v8-FbiQPPo9C1Ib8KkGPu9_SoKRqMMrJA5J&amp;reftype=other&amp;artid=2042183&amp;article-id=2042183&amp;iid=152670&amp;issue-id=152670&amp;jid=2&amp;journal-id=2&amp;FROM=Article%7CLogo&amp;TO=Entrez%7CSearch%7CAll%20PMC&amp;rendering-type=normal&amp;&amp;http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?db=pmc"><area shape="rect" alt="pmc logo image" coords="0,0,145,75" href="./"></map></td><td height="75" valign="top" style="padding-left: 4px;"><div><img align="top" border="0" src="corehtml/pmc/pmcgifs/logo-pnas.gif" alt="Logo of pnas" usemap="#logo-imagemap"><map id="logo-imagemap" name="logo-imagemap"><area shape="rect" alt="PNAS Home page." coords="306,2,479,64" href="redirect3.cgi?&amp;&amp;auth=0pY2YTl-vqPr7aF2aLNTDpzgIBbCi_GD0kBKO5kbl&amp;reftype=publisher&amp;artid=2042183&amp;article-id=2042183&amp;iid=152670&amp;issue-id=152670&amp;jid=2&amp;journal-id=2&amp;FROM=Article%7CBanner&amp;TO=Publisher%7COther%7CN%2FA&amp;rendering-type=normal&amp;&amp;http://www.pnas.org" target="pmc_ext" onclick="focuswin('pmc_ext')"><area shape="rect" alt="Reference to the article." coords="0,34,57,50" onclick="focuswin('pmc_ext') " href="redirect3.cgi?&amp;&amp;auth=0zGIIzC5WLEvfqKSHElQEtk8M1d25AkiF_rzoSAFP&amp;reftype=publisher&amp;artid=2042183&amp;article-id=2042183&amp;iid=152670&amp;issue-id=152670&amp;jid=2&amp;journal-id=2&amp;FROM=Article%7CBanner&amp;TO=Publisher%7CArticle%7CFullText&amp;rendering-type=normal&amp;&amp;http://dx.doi.org/10.1073/pnas.0706813104" target="pmc_ext"><area shape="rect" alt="PNAS Info for Authors" coords="59,34,142,50" href="redirect3.cgi?&amp;&amp;auth=0HWd_iXH6Qcl0f5s9uOzHAIetLCC2bmtjQYHs2ks0&amp;reftype=publisher&amp;artid=2042183&amp;article-id=2042183&amp;iid=152670&amp;issue-id=152670&amp;jid=2&amp;journal-id=2&amp;FROM=Article%7CBanner&amp;TO=Publisher%7COther%7CN%2FA&amp;rendering-type=normal&amp;&amp;http://www.pnas.org/misc/iforc.shtml" target="pmc_ext" onclick="focuswin('pmc_ext')"><area shape="rect" alt="PNAS Subscriptions" coords="143,34,200,50" href="redirect3.cgi?&amp;&amp;auth=0TqK6yujRHFocxfueKe5cgIF9GNp1n6pz4ejumArI&amp;reftype=publisher&amp;artid=2042183&amp;article-id=2042183&amp;iid=152670&amp;issue-id=152670&amp;jid=2&amp;journal-id=2&amp;FROM=Article%7CBanner&amp;TO=Publisher%7COther%7CN%2FA&amp;rendering-type=normal&amp;&amp;http://www.pnas.org/subscriptions/" target="pmc_ext" onclick="focuswin('pmc_ext')"><area shape="rect" alt="PNAS About" coords="201,34,239,50" href="redirect3.cgi?&amp;&amp;auth=0-ORJWxiBCP121eco7KcIRNOaXvTpNFtzlH_UhACH&amp;reftype=publisher&amp;artid=2042183&amp;article-id=2042183&amp;iid=152670&amp;issue-id=152670&amp;jid=2&amp;journal-id=2&amp;FROM=Article%7CBanner&amp;TO=Publisher%7COther%7CN%2FA&amp;rendering-type=normal&amp;&amp;http://www.pnas.org/misc/about.shtml" target="pmc_ext" onclick="focuswin('pmc_ext')"></map></div></td></tr></table></td></tr></table><table cellpadding="0" cellspacing="3" width="100%" border="0"><tr><td></td><td colspan="2"><div class="navlink-box navlink-box-ltblue"><a href="fprender.fcgi" class="navlink">Journal List</a><span> &gt; </span><a class="navlink" href="tocrender.fcgi?journal=2&amp;action=archive">Proc Natl Acad Sci U S A</a><span> &gt; </span><a class="navlink" href="tocrender.fcgi?iid=152670">v.104(41); Oct 9, 2007</a></div></td></tr><tr><td width="145" valign="top" class="sidebar-cell"><div class="sidebar-article-navigation-box"><div class="sidefm-pmclink-item"><a href="articlerender.fcgi?artid=2042183&amp;rendertype=abstract" class="sidefm-pmclink">Abstract</a></div><div class="sidefm-pmccurrent-item"><a class="sidefm-pmclink" href="javascript:return(false);"><span class="sidebar-menu-square-image-holder"><img border="0" src="corehtml/pmc/pmcgifs/square.gif" alt="&gt;"></span>Full Text</a></div><div class="sidefm-pmclink-item"><a href="#supplementary-material-sec" class="sidefm-supplink">Supplementary Material</a></div><div class="sidefm-pmclink-item"><a href="picrender.fcgi?artid=2042183&amp;blobtype=pdf" class="sidefm-pmclink">PDF (493K)</a></div><div class="sidefm-pmclink-item"><a href="tocrender.fcgi?iid=152670" class="sidefm-pmclink">Contents</a></div><div class="sidefm-pmclink-item"><a href="tocrender.fcgi?journal=2&amp;action=archiv