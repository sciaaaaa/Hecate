		<!-- JavaScript function to display random splash image  -->
		<script language="javascript">
		function swapImage(){
		var imgSource=new Array();
		var imgAlt=new Array();
		
			imgSource[0] = "/staticfiles/PHMSA/ImageCollections/Images/homeSplashV2_10.jpg";
			imgAlt[0] = "To prevent emergencies and reduce the consequences (harm to people, environment, and economic impacts) after a pipeline or hazmat failure has occurred. (Includes image of a PHMSA enforcement badge and a US flag.)";
			
			imgSource[1] = "/staticfiles/PHMSA/ImageCollections/Images/homeSplashV2_1.jpg";
			imgAlt[1] = "PHMSA’s mission is to protect people and the environment from the risks inherent in transportation of hazardous materials - by pipeline and other modes of transportation. (Includes image of a ’Before You Dig’ sign.)";
			
			imgSource[2] = "/staticfiles/PHMSA/ImageCollections/Images/homeSplashV2_4.jpg";
			imgAlt[2] = "To harmonize and standardize the requirements for pipeline and hazardous materials transportation internationally, to facilitate efficient and safe transportation through ports of entry and through the supply chain. (Includes illustrative image of gears.)";
			
			imgSource[3] = "/staticfiles/PHMSA/ImageCollections/Images/homeSplashV2_8.jpg";
			imgAlt[3] = "To reduce the risk of harm to people due to the transportation of hazardous materials by pipelines and other modes. (Includes image of a plane.)";
			
			imgSource[4] = "/staticfiles/PHMSA/ImageCollections/Images/homeSplashV2_2.jpg";
			imgAlt[4] = "PHMSA’s mission is to protect people and the environment from the risks inherent in transportation of hazardous materials - by pipeline and other modes of transportation. (Includes image of workers assembling a pipeline pig.)";
			
			imgSource[5] = "/staticfiles/PHMSA/ImageCollections/Images/homeSplashV2_5.jpg";
			imgAlt[5] = "To reduce the risk of harm to people due to the transportation of hazardous materials by pipelines and other modes. (Includes image of a man in front of a truck.)";
			
			imgSource[6] = "/staticfiles/PHMSA/ImageCollections/Images/homeSplashV2_7.jpg";
			imgAlt[6] = "PHMSA’s mission is to protect people and the environment from the risks inherent in transportation of hazardous materials - by pipeline and other modes of transportation. (Includes image of Hazmat placards.)";
			
			imgSource[7] = "/staticfiles/PHMSA/ImageCollections/Images/homeSplashV2_9.jpg";
			imgAlt[7] = "To help maintain and improve the reliability of systems that deliver energy products and other hazardous materials. (Includes image of a train.)";
			
			imgSource[8] = "/staticfiles/PHMSA/ImageCollections/Images/homeSplashV2_3.jpg";
			imgAlt[8] = "To reduce the risk of harm to the environment due to the transportation of oil and hazardous materials by pipeline and other modes. (Includes image of a pipeline winding through a mountain landscape.)";
			
			imgSource[9] = "/staticfiles/PHMSA/ImageCollections/Images/homeSplashV2_6.jpg";
			imgAlt[9] = "To harmonize and standardize the requirements for pipeline and hazardous materials transportation internationally, to facilitate efficient and safe transportation through ports of entry and through the supply chain. (Includes image of a ship.)";
			
		var ranNum = Math.floor(Math.random()*10);
		document.getElementById('rotatingImage').innerHTML = "<img src='" + imgSource[ranNum] + "' alt='" + imgAlt[ranNum] + "'>";
		}
		</script>
		

	<div class="randomImagePageSplash">
	
	
		<div id="rotatingImage"><noscript><img src="/staticfiles/PHMSA/ImageCollections/Images/homeSplashV2_6.jpg" alt="To harmonize and standardize the requirements for pipeline and hazardous materials transportation internationally, to facilitate efficient and safe transportation through ports of entry and through the supply chain. (Includes image of a ship.)"></noscript></div>
		<!-- Call to random image function  -->
		<script language="javascript">
		swapImage();
		</script>
	
	</div>
	





	
	

	

	
    
    

	
		





		 				 	












