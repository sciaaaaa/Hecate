<!--
var plusImgSrc = "/pgdata/images/plus.gif";
var minusImgSrc = "/pgdata/images/minus-white.gif";
var navDiv =document.getElementById("PageNav");
var navNodes = navDiv.getElementsByTagName("UL");
initMenuList(navNodes.item(0));

function initMenuList(menuList) {
  var navNodes = menuList.childNodes;
  for(var i=0; i<navNodes.length; i++) {
    var nextElement = navNodes.item(i);
  	if(nextElement.tagName == "LI")
  		initMenuItem(nextElement);
  }
}

function initMenuItem(menuItem) {
   var imgTag = createMenuImageTag();
   var divTag = menuItem.getElementsByTagName("DIV")[0];    
   //alert (divTag.getElementsByTagName("A")[0].href);
   divTag.insertBefore(imgTag,divTag.childNodes.item(0));
   divTag.getElementsByTagName("A")[0].href="#";
   divTag.getElementsByTagName("A")[0].onclick= function() { processMenuEvent(imgTag, divTag); }
   menuItem.className = "collapsed"; 
   if(menuItem.getElementsByTagName("UL")[0]) {
      menuItem.getElementsByTagName("UL")[0].style.display = "none";
   }
}

function createMenuImageTag() {
   var imgTag = document.createElement("img");
   var nameattr=document.createAttribute("name");
   var srcattr=document.createAttribute("src");
   nameattr.nodeValue="plus";
   srcattr.nodeValue="/pgdata/images/plus.gif";
   imgTag.setAttributeNode(nameattr);
   imgTag.setAttributeNode(srcattr);
   imgTag.onclick = function() { processMenuEvent(this, this.parentNode); }
   return imgTag;
}

function processMenuEvent(navImgTag, menuItem) {
	if(navImgTag.name == "plus") {
	  expandMenu(navImgTag, menuItem)
	}
	else {
	  collapsMenu(navImgTag, menuItem)
	}
}

function expandMenu(navImgTag, menuItem) {
	navImgTag.src = minusImgSrc;
	navImgTag.name = "minus";
	menuItem.className = "expanded"; 
	if(menuItem.getElementsByTagName("UL")[0]) {
		menuItem.getElementsByTagName("UL")[0].style.display = "";
	}
}

function collapsMenu(navImgTag, menuItem) {
	navImgTag.src = plusImgSrc;
	navImgTag.name = "plus";
	menuItem.className = "collapsed"; 
	if(menuItem.getElementsByTagName("UL")[0]) {
		menuItem.getElementsByTagName("UL")[0].style.display = "none";
	}
}
-->
