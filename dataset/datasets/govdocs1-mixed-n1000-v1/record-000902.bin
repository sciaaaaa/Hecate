	<script type="text/javascript">
		function CFC_popup(/*String*/ url, /*String*/ name, /*String*/ features)
			{
			var defaultWidth = 500;
			var defaultHeight = 400;
			
			if (url.indexOf("/") == 0) url = "/publish" + url;
			if (features.indexOf("width") == -1) features += ",width=" + defaultWidth;
			if (features.indexOf("height") == -1) features += ",height=" + defaultHeight;
			var w = window.open(url, name, features);
			w.focus();
			}
	</script>
	

<span class="WideParrichtexteditorText"><h3 dir="ltr" style="margin-right: 0px">&nbsp;&nbsp;&nbsp; In the Spotlight&nbsp;</h3><ul><li><a class="WideParrichtexteditorText" href="http://www.doi.gov/news/09_News_Releases/020409b.html">Secretary&nbsp;Salazar Restores Balance in Controversial Last-Minute Oil&nbsp;and Gas Lease Sale near Utah National Parks</a> <ul type="square"><li><a href="/wo/st/en/info/newsroom/2009/february/canceled_utah_lessees.html" class="WideParrichtexteditorText" id="/content/wo/en/info/newsroom/2009/february/canceled_utah_lessees"><em>77 Utah Oil and Gas Parcels Withdrawn on February 4, 2009</em></a><br />&nbsp;</li></ul></li><li><a class="WideParrichtexteditorText" href="http://www.doi.gov/news/09_News_Releases/020309.html">Secretary&nbsp;Salazar Announces Modified Oil &amp; Gas Lease Sale in Wyoming</a><br />&nbsp;</li><li><a href="/wo/st/en/info/newsroom/2009/january/NR_01_30_2009.html" class="WideParrichtexteditorText" id="/content/wo/en/info/newsroom/2009/january/NR_01_30_2009">BLM and Forest Service Announce 2009 Grazing Fee</a><br />&nbsp;</li><li><a href="/wo/st/en/info/newsroom/2009/january/nr_01_29_2009.html" class="WideParrichtexteditorText" id="/content/wo/en/info/newsroom/2009/january/nr_01_29_2009">Secretary Salazar Outlines High Ethical Standards for Interior Department</a><br />&nbsp;&nbsp;</li><li><a class="WideParrichtexteditorText" href="http://www.doi.gov/news/audio/podcasts/00001c56.mp3">Listen to Secretary Salazar's Thoughts on his New Position and Plans for Future Initiatives</a>&nbsp;<a class="WideParrichtexteditorText" href="http://www.doi.gov/news/audio/podcasts/00001c56.mp3"><img height="13" alt="Podcasts" width="65" border="0" src="http://www.doi.gov/images/podcast_icon_home.gif" /></a></li></ul><ul><li><a href="/wo/st/en/info/newsroom/2009/january/NR_01_16_2009.html" class="WideParrichtexteditorText" id="/content/wo/en/info/newsroom/2009/january/NR_01_16_2009">Public Lands Foundation Honors BLM Employees</a><br />&nbsp;&nbsp;&nbsp;</li><li><a href="/wo/st/en/info/newsroom/2008/december/NR_12_12_2008.html" class="WideParrichtexteditorText" id="/content/wo/en/info/newsroom/2008/december/NR_12_10_2008">BLM Opens Nominations for 2009 Reclamation and Sustainable Mineral Development Awards Program</a>&nbsp;(<a href="/pgdata/etc/medialib/blm/wo/Communications_Directorate/public_affairs/news_release_attachments.Par.85357.File.dat/MineAwardBro09Revu1.pdf" class="WideParrichtexteditorText" id="/etc/medialib/blm/wo/Communications_Directorate/public_affairs/news_release_attachments#Par.85357.File.dat/MineAwardBro09Revu1.pdf">Nomination form</a> - 1.5MB PDF)<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</li><li><a href="/wo/st/en/prog/wild_horse_and_burro.html" class="WideParrichtexteditorText" id="/content/wo/en/prog/wild_horse_and_burro">Sale and Adoption of Wild Horses and Burros</a>&nbsp; <ul><li><font color="#0000ff"><a href="/wo/st/en/info/newsroom/2009/february/NR_02_05_2009.html" class="WideParrichtexteditorText" id="/content/wo/en/info/newsroom/2009/february/NR_02_05_2009">Wild Horse and Burro Advisory Board&nbsp;Meets March 2 in Reno</a></font></li><li><font color="#0000ff"><a href="/wo/st/en/info/newsroom/2008/november/NR_10_11_2008.html" class="WideParrichtexteditorText" id="/content/wo/en/info/newsroom/2008/november/NR_08_11_2008">Statement on GAO Wild Horse Management Report</a></font></li><li><font color="#0000ff"><a href="/wo/st/en/info/newsroom/2008/november/NR_11_19_2008.html" class="WideParrichtexteditorText" id="/content/wo/en/info/newsroom/2008/november/NR_11_19_2008">Recommendations of&nbsp;Wild Horse and Burro Advisory Board</a></font></li><li><font color="#0000ff"><a href="/wo/st/en/prog/wild_horse_and_burro/new_factsheet.html" class="WideParrichtexteditorText" id="/content/wo/en/prog/wild_horse_and_burro/new_factsheet">Fact Sheet&nbsp;on Wild Horse and Burro Management Challenges</a></font></li><li><a href="/wo/st/en/prog/wild_horse_and_burro/Fact_Sheet.html" class="WideParrichtexteditorText" id="/content/wo/en/prog/wild_horse_and_burro/Fact_Sheet">Wild Horse and Burro Quick Facts</a></li><li><a href="/wo/st/en/prog/wild_horse_and_burro/Fact_Sheet/fertility_control.html" class="WideParrichtexteditorText" id="/content/wo/en/prog/wild_horse_and_burro/Fact_Sheet/fertility_control">BLM's Fertility Control Program</a><br />&nbsp;&nbsp;&nbsp;&nbsp;</li></ul></li><li><a href="/wo/st/en/res/blm_jobs.html" class="WideParrichtexteditorText" id="/content/wo/en/res/blm_jobs">Careers with BLM: <strong>Explore the Land...Discover Your Career</strong></a></li></ul></span>
