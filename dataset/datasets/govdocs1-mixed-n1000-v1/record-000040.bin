<script type="text/javascript" src="window.js"></script><script type="text/javascript" src="/cocoon/morf/website_content_hydrogen/javascript/calculator_util.js"></script><script type="text/javascript">
    var unitToCombo;
    var valueField;
    var resultField;

    // Given the ID of a select, rebuild the options based on the conversion type
    function rebuild()
    {
		document.getElementById('accelerationRow').style.display = "none";
		document.getElementById('astronomicalRow').style.display = "none";
		document.getElementById('anglesRow').style.display = "none";
		document.getElementById('areaRow').style.display = "none";
		document.getElementById('distanceRow').style.display = "none";
		document.getElementById('densityRow').style.display = "none";
		document.getElementById('energyRow').style.display = "none";
		document.getElementById('flowRateRow').style.display = "none";
		document.getElementById('forceRow').style.display = "none";
		document.getElementById('frequencyRow').style.display = "none";
		document.getElementById('illuminanceRow').style.display = "none";
		document.getElementById('luminanceRow').style.display = "none";
		document.getElementById('powerRow').style.display = "none";
		document.getElementById('pressureRow').style.display = "none";
		document.getElementById('speedRow').style.display = "none";
		document.getElementById('timeRow').style.display = "none";
		document.getElementById('torqueRow').style.display = "none";
		document.getElementById('massRow').style.display = "none";
		document.getElementById('volumeRow').style.display = "none";

		
		var category = document.calculator.category.value;
		document.getElementById(category+'Row').style.display = "block";
		var unitFromCombo = document.getElementById(category);
		unitToCombo.options.length = 0;
		for(var i = 0; i < unitFromCombo.length; i++) {
			unitToCombo.options[i] = new Option(unitFromCombo.options[i].text, unitFromCombo.options[i].value);	
		}
    }

    // Converts the value from one unit to the other
    function convert()
    {
      var conversionFactor;
      var quantity = document.calculator.valueToConvert.value;
      if (quantity.length == 0) {
		conversionFactor = document.getElementById("conversionFactor");
	  	if (conversionFactor.childNodes[0])
			conversionFactor.removeChild(conversionFactor.firstChild);
	    conversionFactor.appendChild(document.createTextNode(""));
	    document.calculator.result.value = "";
      	return;
      }    	
		var category = document.calculator.category.value;    
		var unitFromCombo = document.getElementById(category);
		var fromValue = unitFromCombo[unitFromCombo.selectedIndex].value;
		//alert(fromValue);
		var toValue = unitToCombo[unitToCombo.selectedIndex].value;
		var valueToConvert = parseFloat(document.calculator.valueToConvert.value);
		var conversionFactorValue = parseFloat(fromValue) / parseFloat(toValue);
		//alert(toValue);
		
		conversionFactor = document.getElementById("conversionFactor");
	  	if (conversionFactor.childNodes[0])
			conversionFactor.removeChild(conversionFactor.firstChild);
	    conversionFactor.appendChild(document.createTextNode(formatNumber(conversionFactorValue)));
		document.calculator.result.value = formatNumber(conversionFactorValue * valueToConvert);

    }
    


    // Called onload
    function startup()
    {
		unitToCombo = document.getElementById('unitTo');
    	rebuild();
    }


  </script>
