  <TITLE>Hurry-Up Syndrome</TITLE>
</HEAD>
<BODY BGCOLOR="#ffffff">
<P ALIGN=CENTER>
<TABLE WIDTH="100%" BORDER="1" CELLSPACING="2" CELLPADDING=
"0">
  <TR> 
    <TD WIDTH="50%"> 
      <P ALIGN=CENTER><font face="Arial, Helvetica, sans-serif">&nbsp;<IMG SRC="dl_sml_logo.jpg" WIDTH="144" HEIGHT="22"
ALIGN="BOTTOM" NATURALSIZEFLAG="3" alt="ASRS Directline"> </font>
    </TD>
    <TD WIDTH="50%">
      <P ALIGN=CENTER><font face="Arial, Helvetica, sans-serif">&nbsp;<B>Issue 
        Number 5 : March 1993</B></font>
    </TD>
