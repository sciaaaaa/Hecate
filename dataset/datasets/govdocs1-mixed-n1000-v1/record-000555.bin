le"><h2><a id="ctl00_ucSiteTopic_hlSiteTopic" href="./">Travelers' Health - Yellow Book</a></h2></div></div><div id="content"><div id="content-inner"><div id="nav-container"><div id="nav"><h3><a href="/travel/">Home</a></h3><ul id="nav-primary"><li><a href="/travel/destinationList.aspx" title="Destinations">Destinations</a><ul><li><a href="/travel/regionList.aspx" title="Regions">Regions</a></li></ul></li><li><a href="/travel/contentVaccinations.aspx" title="Vaccinations">Vaccinations</a></li><li><a href="/travel/news.aspx" title="Travel Notices">News &amp; Announcements</a></li><li><a href="/travel/notices.aspx" title="Travel Notices">Travel Notices</a></li><li><a href="/travel/contentDiseases.aspx" title="Diseases">Diseases</a></li><li><a href="/travel/contentYellowBook.aspx" title="Yellow Book">Yellow Book</a><ul><li><a href="/travel/ybSearch.aspx" title="Search">Search</a></li><li><a href="/travel/ybToc.aspx" title="Contents">Contents</a><ul><li><a href="/travel/ybToc.aspx#1" title="Chapter 1">Chapter 1</a></li><li><a href="/travel/ybToc.aspx#2" title="Chapter 2">Chapter 2</a></li><li><a href="/travel/ybToc.aspx#3" title="Chapter 3">Chapter 3</a></li><li><a href="/travel/ybToc.aspx#4" title="Chapter 4">Chapter 4 (50)</a><ul><li><a href="/travel/yellowBookCh4-Rickettsial.aspx" title="Rickettsial Infections">Rickettsial Infections</a></li></ul><a href="/travel/ybToc.aspx#4" title="Chapter 4">more</a></li><li><a href="/travel/ybToc.aspx#5" title="Chapter 5">Chapter 5</a></li><li><a href="/travel/ybToc.aspx#6" title="Chapter 6">Chapter 6</a></li><li><a href="/travel/ybToc.aspx#7" title="Chapter 7">Chapter 7</a></li><li><a href="/travel/ybToc.aspx#9" title="Chapter 8">Chapter 8</a></li><li><a href="/travel/ybToc.aspx#11" title="Chapter 9">Chapter 9</a></li></ul></li><li><a href="/travel/yellowBookListOfMaps.aspx" title="Maps">Maps</a></li><li><a href="/travel/yellowBookListOfTables.aspx" title="Tables">Tables</a></li><li><a href="/travel/contentYellowBookAbout.a