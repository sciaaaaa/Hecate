\par }\pard \ql \li0\ri0\nowidctlpar\brdrt\brdrs\brdrw60\brsp20 \wrapdefault\faauto\rin0\lin0\rtlgutter\itap0 {\f36\fs22\insrsid7698630 11215 Research Blvd Apt 2180, Austin, TX 78759 
