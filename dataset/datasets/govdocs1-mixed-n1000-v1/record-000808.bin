\par }\pard \ql \li0\ri0\nowidctlpar\brdrt\brdrs\brdrw60\brsp20 \wrapdefault\faauto\rin0\lin0\rtlgutter\itap0 {\f36\fs22\insrsid7698630 674 SHERIDAN DR , LEXINGTON, KY 40503 
