{\*\xmlopen\xmlns1{\factoidname City}}Yellow Springs{\*\xmlclose}, {\*\xmlopen\xmlns1{\factoidname State}}OH{\*\xmlclose} {\*\xmlopen\xmlns1{\factoidname PostalCode}}45387{\*\xmlclose}{\*\xmlclose} 
\par }\pard \ql \li0\ri0\nowidctlpar\wrapdefault\faauto\rin0\lin0\itap0 {\f36\insrsid7698630 
