<SCRIPT language=JAVASCRIPT>
//JAVASCRIPTS start here
function TaxID()
	{	
		taxnum = document.freeform.TAXID.options[document.freeform.TAXID.selectedIndex].value;
		querystr = document.freeform.querytext.value;
		querystr = querystr + "[TAX_ID]=" + taxnum;
	    document.freeform.querytext.value = querystr;
    }
function getSubID()
	{
		selection = document.searchID.Type;
   		gettype = selection.options[selection.selectedIndex].value;
		b = document.searchID.sub_id.value;
		if (gettype == "dbSNP_rs")
		{	
			var numstr = /rs\d+$/;	
    		if (!(b.match(numstr)) ) {
   		    	alert (b + " is incorrect format!\nThe ID should have the prefix \"rs\" and a number \n (eg. rs23131)");
				return false;}
		}
		if (gettype == "dbSNP_ss")
		{
			var numstr = /ss\d+$/;	
    		if (!(b.match(numstr)) ) {
   		    	alert (b + " is incorrect format!\nThe ID should have the prefix \"ss\" and a number \n (eg. ss23131)");
				return false;}
		}
	}
function getSTSname()
	   {
   		if ((document.STSSearch.STSname1.value == "") || (document.STSSearch.STSname2.value == ""))
      		{
      		alert("Please enter two STS markers!")
      		document.STSSearch.STSname1.focus();
      		return false;
      		}
      	else 
      		{
      		return true; 
      		}
   }
	
	
</SCRIPT>
