// -----  Quadratic measure (metric):
//
d( Area, squaremeter,      m2,  sq(     meter) )
d( Area, squaremillimeter, mm2, sq(millimeter) )
d( Area, squarecentimeter, cm2, sq(centimeter) )
d( Area, squarekilometer,  km2, sq( kilometer) )

u( Area, are,     /*a,*/ sq(10. * meter) )
