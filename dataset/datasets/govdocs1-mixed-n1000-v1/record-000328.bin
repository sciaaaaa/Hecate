<!--
    function  _CF_checkBasicSearch(_CF_this)
    {
        //reset on submit
        _CF_error_exists = false;
        _CF_error_messages = new Array();
        _CF_error_fields = new Object();
        _CF_FirstErrorField = null;

        //form element ReportDateFrom 'DATE' validation checks
        if (!_CF_checkdate(_CF_this['ReportDateFrom'].value, false))
        {
            _CF_onError(_CF_this, "ReportDateFrom", _CF_this['ReportDateFrom'].value, "Please enter valid date in format: mm/dd/yyyy");
            _CF_error_exists = true;
        }

        //form element ReportDateTo 'DATE' validation checks
        if (!_CF_checkdate(_CF_this['ReportDateTo'].value, false))
        {
            _CF_onError(_CF_this, "ReportDateTo", _CF_this['ReportDateTo'].value, "Please enter valid date in format: mm/dd/yyyy");
            _CF_error_exists = true;
        }


        //display error messages and return success
        if( _CF_error_exists )
        {
            if( _CF_error_messages.length > 0 )
            {
                // show alert() message
                _CF_onErrorAlert(_CF_error_messages);
                // set focus to first form error, if the field supports js focus().
                if( _CF_this[_CF_FirstErrorField].type == "text" )
                { _CF_this[_CF_FirstErrorField].focus(); }

            }
            return false;
        }else {
            return true;
        }
    }
//-->
</script>
