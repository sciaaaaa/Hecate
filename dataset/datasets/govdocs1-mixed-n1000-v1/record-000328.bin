				<TR><TD>
					<TABLE>

					<TR><TD><B><A Name="Manufacturer" Title="Brand name is or begins with:"><label for="BrandName">Brand Name</label><A Name="Brand" Title="Brand name is or begins with:"></B></TD>
					<TD><INPUT TYPE="text" NAME="BrandName" ID="BrandName" SIZE="20" MAXLENGTH="30"></TD>
					</TR>
					<TR><TD><B><A Name="Manufacturer" Title="Manufacturer name is or begins with:"><label for="Manufacturer">Manufacturer</label></A></B></TD>
					<TD><INPUT TYPE="text" NAME="Manufacturer" ID="Manufacturer" SIZE="20" MAXLENGTH="30"></TD>
					</TR>
					<TR><TD ALIGN="left"><B><label for="EventType">Event Type</label></B></TD>
					<TD><SELECT NAME="EventType" ID="EventType">
					<OPTION SELECTED>
					<OPTION VALUE="Death">Death
					<OPTION VALUE="Injury">Injury
					<OPTION VALUE="Malfunction">Malfunction
					<OPTION VALUE="Other">Other
					<OPTION VALUE="NoAnswerProvided">No Answer Provided
					</SELECT>
					</TD>
					</TR>
					</TABLE>
				</TD>
				<TD>
					<TABLE>
					<TR><TD><B><A Name="510K" Title="510K Number is or begins with"><label for="KNumber">510K Number</label></A></B></TD>
					<TD><INPUT TYPE="text" NAME="KNumber" ID="KNumber" VALUE="K" SIZE="7" MAXLENGTH="7"></TD>
					</TR>
					<TR><TD><B><A Name="PMA" Title="PMA Number is or begins with"><label for="PMANumber">PMA Number</label></A></B></TD>
					<TD><INPUT TYPE="text" NAME="PMANumber" ID="PMANumber" VALUE="P" SIZE="7" MAXLENGTH="7"></TD>
					</TR>
					<TR><TD><B><A Name="ProductCode" Title="Product Code Classification Database information" href="http://www.fda.gov/cdrh/Prodcode.html">Product Code</A></B></TD>
					<TD><INPUT TYPE="text" NAME="ProductCode" ID="ProductCode" SIZE="3" MAXLENGTH="3"></TD>
					</TR>
					</TABLE>
				</TD>
				</TR>
				<TR>
				<TD ALIGN="CENTER" COLSPAN=2>
					<TABLE WIDTH="100%">
					<TR>
					<TD><B><A Name="DateReportReceived" Title="Date the report was received by the FDA. The date of the event is not available. The dates of initial or subsequent reports may not be available or reliable."><label for="ReportDateFrom">Date Report Received by FDA</label></A>&nbsp;<I><FONT SIZE= -1>(mm/dd/yyyy)</FONT></I></B></TD>
					<TD>
					
					
					
					<input name="ReportDateFrom" type="text" value="01/01/2009" maxlength="10"  size="10"  id="ReportDateFrom"  />
					&nbsp;<a href="javascript:show_calendar('BasicSearch.ReportDateFrom');" onmouseover="window.status='Date Picker';return true;" onmouseout="window.status='';return true;"><img src="show-calendar.gif" width="24" height="22" border="0" alt="use calendar to select date"></a></TD>
					<TD ALIGN="middle"><B><label for="ReportDateTo">to</label></B></TD>
					<TD ALIGN="right">
					
					
					
					<input name="ReportDateTo" type="text" value="01/06/2009" maxlength="10"  size="10"  id="ReportDateTo"  />
					&nbsp;<a href="javascript:show_calendar('BasicSearch.ReportDateTo');" onmouseover="window.status='Date Picker';return true;" onmouseout="window.status='';return true;"><img src="show-calendar.gif" width="24" height="22" border="0" alt="use calendar to select date"></a>
					</TD>
					</TR>
					</TABLE>
				</TD>
				</TR>
				<tr><td ALIGN="center" colspan=2><p style="font-size: 8pt;">For full-text search, select <em>Go To Simple Search</em> button</p></TD></TR>
				</table>
			</td></tr>
