<form method="POST" action="http://compbio.mcs.anl.gov/puma2/cgi-bin/search.cgi">

<input type="hidden" name="header" value="pathos">

<input type="hidden" name="search" value="Submit">

<table bgcolor="#FFFFFF" cellpadding="5" cellspacing="2" border="0">

<tr>
<td bgcolor="#DBE9F4" align="right">
&nbsp;<br>
<font face="Verdana, Arial, Helvetica"><b>Search type:</b></font>&nbsp;&nbsp;<br>
&nbsp;
</td>

<td bgcolor="#DBE9F4" valign="top" align="left">
<input type="radio" name="search_type" value="protein_id" checked>
<font face="Verdana, Arial, Helvetica">Protein ID</font>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
<br>
&nbsp;&nbsp;
<select name="protein_id_type">
<option value="NCBI_GI">NCBI gi
<option value="PIR_ID">PIR NREF id
</select>
</td>

<td bgcolor="#DBE9F4" valign="top" align="left">
<input type="radio" name="search_type" value="ec">
<font face="Verdana, Arial, Helvetica">EC number</font>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br>
&nbsp;&nbsp;<a href="http://compbio.mcs.anl.gov/puma2/cgi-bin/ec.cgi?&header=pathos">(browse enzymes)</a>
</td>

<td bgcolor="#DBE9F4" valign="top" align="left">
<input type="radio" name="search_type" value="function">
<font face="Verdana, Arial, Helvetica">Function keyword(s)</font>
&nbsp;&nbsp;<br>
</td>

<td bgcolor="#DBE9F4" valign="top" align="left">
<input type="radio" name="search_type" value="gene">
<font face="Verdana, Arial, Helvetica">Gene name</font>
&nbsp;&nbsp;<br>
</td>

<td bgcolor="#DBE9F4" valign="top" align="left">
<input type="radio" name="search_type" value="locus">
<font face="Verdana, Arial, Helvetica">Locus tag</font>
&nbsp;&nbsp;<br>
</td>

</tr>

<tr>
<td bgcolor="#DBE9F4" align="right">
&nbsp;<br>
<font face="Verdana, Arial, Helvetica">
<b>Search text:</b></font>&nbsp;&nbsp;<br>
&nbsp;
</td>

<td colspan="5">
<input name="search_text" size="50">
<input type="submit" name="search" value="Submit">
<input type="reset">
</td>
</tr>

