	    function mouseOver( name ) {
                if( name != selected )
                    eval( "document." + name + ".src = " + name +
			  "_rollover.src" );
            }

            function mouseOut( name ) {
                if( name != selected )
                    eval( "document." + name + ".src = " + name +
			  "_not_selected.src" );
            }

            function clicked( name ) {
                if( name != selected ) {
                    // Switch selected to not selected and name to selected
                    if( selected != '' )
                        eval( "document." + selected + ".src = " + selected +
			      "_not_selected.src" );
                    eval( "document." + name + ".src = " + name +
			  "_selected.src" );
                    selected = name;
                }
            }
