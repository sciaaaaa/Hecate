<script type="text/javascript" language="JavaScript">
<!-- Hide script from incompatible browsers! -->
function openPhyloWindow() {
    child = window.open("http://compbio.mcs.anl.gov/ulrich/phyloblock/indexEKB.html",
                        "PhyloWindow", "width=550,height=580" + ",statusbar=yes" +
                        ",toolbar=yes,resizable=yes,scrollbars=yes,menubar=yes")
}

function updatePhyloWindow( nref ) {
    if (self.child.document.Form1.data.value.match(nref))
        self.child.document.Form1.data.value = 
            self.child.document.Form1.data.value.replace(nref+' ', '')
    else
        self.child.document.Form1.data.value += nref + ' ';
}

function clearPhyloWindow() {
    self.child.document.Form1.data.value = '';
}
//   Hide script from incompatible browsers! -->
</script>

